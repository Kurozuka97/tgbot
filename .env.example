# --- Required ---
BOT_TOKEN=                # from @BotFather
ADMIN_ID=                 # your Telegram user ID (admin commands)
WEBHOOK_SECRET=           # openssl rand -hex 32

# --- AI providers (at least one required) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Firestore (service-account credentials) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=     # keep the \n escapes when set via CLI/dashboard

# --- Optional ---
GITHUB_TOKEN=             # increases GitHub search rate limits
DAILY_AI_LIMIT=           # per-user AI calls per day (default 50)
LOSSLESS_FETCH_TIMEOUT=   # ms timeout for lossless file fetches (default 20000)
OPENROUTER_IMAGE_MODEL=   # /imagine model (default google/gemini-3.1-flash-image)
